# Compose settings. Copy to .env beside docker-compose.yml.
# be/.env is only used when running the backend directly, outside Docker.
BACKEND_PORT=8000
UVICORN_LOG_LEVEL=debug
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_ROUTER_MODEL=qwen2.5:0.5b
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:8b
MAX_UPLOAD_BYTES=52428800

QDRANT_COLLECTION=pdf_chunks
DEPENDENCY_TIMEOUT_SECONDS=120
EMBEDDING_BATCH_SIZE=16

RETRIEVAL_TOP_K=10
RETRIEVAL_RELATIVE_THRESHOLD=0.7
RETRIEVAL_FINAL_K=4

CHAT_CONTEXT_MESSAGES=10
CHAT_CONTEXT_CHARACTERS=6000
ROUTER_CONTEXT_MESSAGES=2
ROUTER_CONTEXT_CHARACTERS=1500
ROUTER_TIMEOUT_SECONDS=20
